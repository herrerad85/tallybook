<!--
  One part of a split transaction in the editor. The label is the category of the part and the
  text its amount and note. It has no id, since there is one per part and the editor keeps the
  parts itself across a recreate.
-->
<com.oriondev.moneywallet.ui.view.theme.ThemedMaterialEditText
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:inputType="textMultiLine"
    android:saveEnabled="false"
    app:met_mode="floatingLabel"
    app:met_leftIcon="@drawable/ic_table_large_24dp" />
